OPENAI_API_KEY=
SITE_PASSWORD=
# Required for regional OpenAI projects. Leave blank to use api.openai.com.
OPENAI_BASE_URL=https://us.api.openai.com/v1
# Optional model overrides
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_COACHING_MODEL=gpt-5-mini

# Supabase: Project Settings -> API / Data API
# Use the project root URL only (for example https://your-project.supabase.co), never /rest/v1.
NEXT_PUBLIC_SUPABASE_URL=
# Use the Supabase Publishable key (or the legacy anon public key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
